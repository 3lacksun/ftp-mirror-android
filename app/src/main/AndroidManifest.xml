<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_stone_sync_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_stone_sync_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FtpMirror"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".PinActivity"
            android:exported="true"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PairEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".LocalExplorerActivity" android:exported="false" />
        <activity android:name=".RemoteExplorerActivity" android:exported="false" />

        <service
            android:name=".MirrorForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
