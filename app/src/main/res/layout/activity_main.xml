<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_surface"
        app:title="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/md_theme_primary_container"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/status_idle" android:textSize="24sp" android:textStyle="bold"
                        android:textColor="@color/md_theme_on_primary_container" />
                    <TextView android:id="@+id/tvLastRun" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Last run: Never" android:textSize="13sp"
                        android:textColor="@color/md_theme_on_primary_container" android:layout_marginTop="6dp" />
                    <TextView android:id="@+id/tvStats" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="↑ 0 uploaded   ↓ 0 downloaded" android:textSize="13sp"
                        android:textColor="@color/md_theme_on_primary_container" android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunNow" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:text="@string/run_now" android:layout_marginEnd="6dp" app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:text="@string/cancel_run" android:layout_marginStart="6dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" app:cornerRadius="14dp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Folder pairs" android:textStyle="bold" android:textSize="13sp"
                android:textColor="@color/md_theme_outline" android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/pairContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Add pair"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="14dp"
                android:layout_marginBottom="20dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Scheduled sync" android:textStyle="bold" android:textSize="13sp"
                android:textColor="@color/md_theme_outline" android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/md_theme_card"
                app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/md_theme_surface_variant"
                app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Spinner android:id="@+id/spinnerInterval" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveSchedule" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Save schedule" app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Recent activity" android:textStyle="bold" android:textSize="13sp"
                android:textColor="@color/md_theme_outline" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/tvHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/no_history" android:textSize="13sp" android:textColor="@color/md_theme_on_surface_variant"
                android:fontFamily="monospace" android:layout_marginBottom="16dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="FTP Mirror 3.0.0" android:gravity="center" android:textSize="11sp"
                android:textColor="@color/md_theme_outline" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
